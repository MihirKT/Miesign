# Miesign backend settings. Copy to .env or export in your shell; every value is optional.
# Defaults shown are what config/settings.py uses when the variable is unset. No secrets belong here.

# --- Django ---
# Signing key. The default is for local development only; set a long random value in production.
DJANGO_SECRET_KEY=dev-only-not-secret
# "1" turns debug on. Use 0 in production.
DJANGO_DEBUG=1
# Comma-separated hostnames the server answers to.
DJANGO_ALLOWED_HOSTS=*
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Google Vertex AI (auth is Application Default Credentials: gcloud auth application-default login) ---
# Google Cloud project billed for Gemini calls (default: project-1a771a61-0f54-4d61-b3b).
GCP_PROJECT=project-1a771a61-0f54-4d61-b3b
# Vertex location. "global" is required for the preview models.
GCP_LOCATION=global
# Model for photo check, part detection, design parsing and grounded rate search.
MODEL_TEXT=gemini-3.5-flash
# Model for the photo-to-render edit.
MODEL_IMAGE=gemini-3.1-flash-image

# --- Limits and caches ---
# Previews (renders) allowed per project; a failed render is refunded.
RENDER_CAP=8
# Days a web-sourced rate stays cached per city and material.
RATE_CACHE_DAYS=30
# Hours a tier-estimated rate stays cached before the web search is tried again.
RATE_ESTIMATE_CACHE_HOURS=24
# Shortest allowed photo side in pixels.
MIN_PHOTO_SIDE=400
# Minimum edge variance below which a photo is rejected as blurry or flat.
BLUR_MIN_VARIANCE=40
# Largest accepted upload in bytes (15 MB).
MAX_UPLOAD_BYTES=15728640
# Photos allowed per project.
MAX_PHOTOS=5
